msgid "DDL 审计表"
msgstr "DDL audit table"

msgid "库.表，默认表名 starrocks_audit_db__.starrocks_audit_tbl__；需要安装 AuditLoader 插件并授权采集账号 SELECT；留空表示未绑定审计表"
msgstr "database.table; default table: starrocks_audit_db__.starrocks_audit_tbl__. Install the AuditLoader plugin and grant SELECT to the collection account. Leave blank if no audit table is bound."

msgid "未绑定审计表：请在数据源选项 ddl_audit_table 中绑定 AuditLoader 审计表"
msgstr "No audit table is bound: bind an AuditLoader audit table in the data source option ddl_audit_table"

msgid "未绑定审计表：请在数据源选项 ddl_audit_table 中绑定 MySQL DDL 审计表"
msgstr "No audit table is bound: bind a MySQL DDL audit table in the data source option ddl_audit_table"

msgid "StarRocks 审计表名称无效：请使用库.表，可用反引号引用名称"
msgstr "Invalid StarRocks audit table name: use database.table; names may be quoted with backticks"

msgid "StarRocks 审计表缺少必需字段：{fields}；请核对 AuditLoader 版本和表结构"
msgstr "The StarRocks audit table is missing required fields: {fields}; check the AuditLoader version and table schema"

msgid "StarRocks 审计表字段类型不符：{fields}"
msgstr "The StarRocks audit table has incompatible field types: {fields}"

msgid "无法确定 StarRocks FE 默认时区，不能解释审计 timestamp"
msgstr "Cannot determine the default StarRocks FE time zone or interpret the audit timestamp"

msgid "StarRocks 审计表 {table} 不存在；请安装 AuditLoader 插件并绑定审计表（{error}）"
msgstr "StarRocks audit table {table} does not exist; install the AuditLoader plugin and bind the audit table ({error})"

msgid "采集账号无权读取 StarRocks 审计表 {table}；请授予 SELECT 权限（{error}）"
msgstr "The collection account cannot read StarRocks audit table {table}; grant SELECT permission ({error})"

msgid "StarRocks 审计表 {table} 读取失败：{error}"
msgstr "Failed to read StarRocks audit table {table}: {error}"

msgid "StarRocks 审计记录无效或语句可能被截断，无法可靠归因"
msgstr "The StarRocks audit record is invalid or its statement may be truncated; reliable attribution is unavailable"

msgid "StarRocks 审计记录包含暂不支持的转义对象名称，无法可靠归因"
msgstr "The StarRocks audit record contains an escaped object name that is not yet supported; reliable attribution is unavailable"

msgid "DDL 审计来源不覆盖此 Catalog，无法归因"
msgstr "The DDL audit source does not cover this Catalog; attribution is unavailable"

msgid "采集账号需模式上的 VIEW DEFINITION；查询账号需 SELECT 与 VIEW DEFINITION；object_id 作物理身份；不报告数据新鲜度；2026-11-01 已实机验证 SQL Server 2022 的 DDL 归因；需启用默认跟踪，并授予 ALTER TRACE（相关读取若需 VIEW SERVER STATE 也须授权）；默认跟踪异步写盘：实机 DDL 后约 2 秒内可能缺记录、6 秒后稳定；采集后最多等待 10 秒再读取默认跟踪，以本次快照读取开始时间加 10 秒为等待截止，等待不是落盘保证；只采用已提交的对象级事件；当前目录恢复的模式仅作候选，无法确证历史模式或点名列时不确定归因；StartTime 按服务器本地时间换算 UTC，使用服务器当前偏移；演示实例偏移为 0，本地时间换 UTC 与跨夏令时未实机验证，跨夏令时可能不准确"
msgstr "The collection account needs VIEW DEFINITION on the schemas; the query account needs SELECT and VIEW DEFINITION; object_id provides physical identity; data freshness is not reported. DDL attribution was validated on a real SQL Server 2022 instance on 2026-11-01. Default trace must be enabled and ALTER TRACE granted (also grant VIEW SERVER STATE if required by related reads). Default trace writes asynchronously: real-instance observations found records could be missing within about 2 seconds after DDL and appeared reliably after 6 seconds. After collection, wait up to 10 seconds before reading default trace, with the deadline set to 10 seconds after the current snapshot read starts. Waiting does not guarantee records have reached disk. Only committed object-level events are used. Schemas recovered from the current catalog provide candidates only; no definite attribution is made when the historical schema or affected columns cannot be established. StartTime is converted from server local time to UTC using the current server offset. The demo instance had an offset of 0; local-time-to-UTC conversion and daylight saving transitions have not been validated on real instances, and conversion across daylight saving transitions may be inaccurate."

msgid "无法确定 MySQL lower_case_table_names，不能可靠解析库表名"
msgstr "Cannot determine MySQL lower_case_table_names; database and table names cannot be resolved reliably"

msgid "采集账号需 SELECT_CATALOG_ROLE；OBJECT_ID 作物理身份；标识符按大写保存；不报告数据新鲜度；2026-11-01 已实机验证 Oracle 23ai Free 的 DDL 归因，使用自建统一审计策略（CREATE / ALTER / DROP TABLE、CREATE / DROP VIEW、COMMENT、RENAME、TRUNCATE TABLE）与 AUDIT_VIEWER；只采用 RETURN_CODE = 0 的成功记录；优先 EVENT_TIMESTAMP_UTC，旧版 EVENT_TIMESTAMP 在 UTC 审计会话中读取；无记录且无策略的 not_enabled 分支未实机验证"
msgstr "The collection account needs SELECT_CATALOG_ROLE; OBJECT_ID provides physical identity; unquoted identifiers are stored in uppercase; data freshness is not reported. DDL attribution was validated on a real Oracle 23ai Free instance on 2026-11-01 using a custom unified audit policy (CREATE / ALTER / DROP TABLE, CREATE / DROP VIEW, COMMENT, RENAME, TRUNCATE TABLE) and AUDIT_VIEWER. Only successful records with RETURN_CODE = 0 are used. EVENT_TIMESTAMP_UTC is preferred; on older versions, EVENT_TIMESTAMP is read in a UTC audit session. The not_enabled branch with neither records nor an enabled policy has not been validated on real instances."

msgid "SQL Server 默认跟踪未开启（default trace enabled = 0）"
msgstr "SQL Server default trace is disabled (default trace enabled = 0)"

msgid "采集账号缺少 SQL Server 默认跟踪读取权限（需要 ALTER TRACE；相关读取可能还需要 VIEW SERVER STATE）"
msgstr "The collection account lacks permission to read SQL Server default trace (ALTER TRACE is required; related reads may also require VIEW SERVER STATE)"

msgid "无法判断采集账号是否具有 SQL Server 默认跟踪读取权限（ALTER TRACE 权限检查返回 NULL）；请确认相关授权"
msgstr "Cannot determine whether the collection account can read SQL Server default trace (the ALTER TRACE permission check returned NULL); verify the required grants"

msgid "SQL Server 默认跟踪未运行或没有可读取的跟踪文件"
msgstr "SQL Server default trace is not running or has no readable trace file"

msgid "SQL Server 默认跟踪配置或服务器时区偏移无法读取"
msgstr "SQL Server default trace configuration or the server's time zone offset could not be read"

msgid "SQL Server 默认跟踪记录结构不符：{error}"
msgstr "SQL Server default trace records have an incompatible structure: {error}"

msgid "SQL Server 默认跟踪读取失败：{error}"
