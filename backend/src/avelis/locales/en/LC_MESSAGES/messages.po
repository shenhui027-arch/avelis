msgid "Oracle 统一审计中没有相关的成功 DDL 记录，且未启用记录这些操作成功结果的审计策略"
msgstr "Oracle unified audit has no relevant successful DDL records, and no enabled audit policy records successful outcomes of these operations"

msgid "采集账号无权读取 Oracle 统一审计；请授予 AUDIT_VIEWER 或相应读取权限（{error}）"
msgstr "The collection account cannot read Oracle unified audit; grant AUDIT_VIEWER or the corresponding read privileges ({error})"

msgid "Oracle 统一审计来源结构与连接器要求不符（{error}）"
msgstr "The Oracle unified audit source structure does not meet the connector's requirements ({error})"

msgid "读取 Oracle 统一审计失败（{error}）"
msgstr "Failed to read Oracle unified audit ({error})"

msgid "DDL 审计记录包含 MySQL 可执行注释，无法可靠确定候选"
msgstr "The DDL audit record contains MySQL executable comments; candidates cannot be determined reliably"

msgid "DDL 审计语句缺少当前库上下文：存在未限定库名的对象，无法可靠确定候选"
msgstr "The DDL audit statement lacks current database context: an object has no database qualifier, so candidates cannot be determined reliably"

msgid "DDL 审计记录包含多条语句，无法可靠确定候选"
msgstr "The DDL audit record contains multiple statements; candidates cannot be determined reliably"

msgid "超时值必须为正数，未执行"
msgstr "The timeout must be positive; nothing was executed"

msgid "DDL 审计候选超过读取上限（{limit} 条），无法完整归因"
msgstr "DDL audit candidates exceed the read limit ({limit} rows); complete attribution is unavailable"

msgid "未绑定 DDL 审计表（options.ddl_audit_table），没有审计来源"
msgstr "No DDL audit table is bound (options.ddl_audit_table); there is no audit source"

msgid "DDL 审计表名称无效：请填写库.表"
msgstr "Invalid DDL audit table name: enter database.table"

msgid "DDL 审计表 {table} 结构不符：缺少列 {columns}"
msgstr "DDL audit table {table} has an incompatible schema: missing columns {columns}"

msgid "DDL 审计表 {table} 的 event_time 必须为 TIMESTAMP；不能推测 DATETIME 的时区"
msgstr "event_time in DDL audit table {table} must be TIMESTAMP; the time zone of DATETIME cannot be inferred"

msgid "DDL 审计表 {table} 的 user_host、command_type、argument 必须为文本或二进制列"
msgstr "user_host, command_type, and argument in DDL audit table {table} must be text or binary columns"

msgid "DDL 审计表的 {column} 不是有效的 UTF-8 文本"
msgstr "{column} in the DDL audit table is not valid UTF-8 text"

msgid "MySQL 通用查询日志未写入表：需要 general_log=ON 且 log_output 包含 TABLE"
msgstr "The MySQL general query log is not writing to a table: general_log=ON and TABLE in log_output are required"

msgid "读取 DDL 审计表 {table} 失败：{error}"
msgstr "Failed to read DDL audit table {table}: {error}"

msgid "DDL 审计表的 user_host 无法解析数据库用户名，不能归因"
msgstr "The database username cannot be parsed from user_host in the DDL audit table; attribution is unavailable"

msgid "DDL 审计表的 event_time 不是有效的时间值"
msgstr "event_time in the DDL audit table is not a valid timestamp"

msgid "查询行数上限不能为负数，未执行"
msgstr "The query row limit must not be negative; nothing was executed"

msgid "MySQL 视图 {name} 未读取到定义（需要 SHOW VIEW 权限）；列级血缘不可用"
msgstr "No definition was read for MySQL view {name} (SHOW VIEW is required); column-level lineage is unavailable"

msgid "可选绑定库.表，如 mysql.general_log；通用日志需 general_log=ON 且 log_output 含 TABLE，采集账号需 SELECT；兼容审计表需 event_time（TIMESTAMP）、user_host、command_type、argument"
msgstr "Optionally bind database.table, such as mysql.general_log; the general log requires general_log=ON, TABLE in log_output, and SELECT for the collection account; compatible audit tables require event_time (TIMESTAMP), user_host, command_type, and argument"

msgid "采集账号需元数据可见性与 SHOW VIEW；问数使用专用只读账号（SELECT 与 SHOW VIEW）；server_uuid 确认实例身份；不报告数据新鲜度；2026-11-01 已实机验证 MySQL 8.4.10；DDL 归因需绑定审计表，未绑定时不支持归因；general_log 实测也记录执行失败的 DDL，只作候选证据，与结构变化交叉核对；审计时间统一按 UTC 读取"
msgstr "The collection account needs metadata visibility and SHOW VIEW; queries use a dedicated read-only account (SELECT and SHOW VIEW); server_uuid identifies the instance; data freshness is not reported. MySQL 8.4.10 was validated on a real instance on 2026-11-01. DDL attribution requires an audit table binding and is unsupported without one. Real-instance testing confirmed that general_log also records failed DDL, so it provides candidate evidence only, cross-checked against schema changes; audit timestamps are read in UTC."

msgid "2026-11-01 已实机验证 StarRocks 3.5.14 + AuditLoader 4.2.2；DDL 归因需绑定审计表并授予 SELECT，未绑定时不支持归因；FE 时区为 UTC，非 UTC 换算未实机验证；插件刚安装后的几十秒内可能未记录语句，此时归因为未匹配"
msgstr "Validated on real instances on 2026-11-01 with StarRocks 3.5.14 + AuditLoader 4.2.2; DDL attribution requires a bound audit table and SELECT permission, and is unsupported without a binding. The FE time zone was UTC; conversion from non-UTC time zones has not been validated on real instances. Statements issued within the first tens of seconds after plugin installation may not be recorded and are then unmatched."

