msgstr "Oracle unified audit has no relevant successful DDL records, and no enabled audit policy records successful outcomes of these operations"

msgid "采集账号无权读取 Oracle 统一审计；请授予 AUDIT_VIEWER 或相应读取权限（{error}）"
msgstr "The collection account cannot read Oracle unified audit; grant AUDIT_VIEWER or the corresponding read privileges ({error})"

msgid "Oracle 统一审计来源结构与连接器要求不符（{error}）"
msgstr "The Oracle unified audit source structure does not meet the connector's requirements ({error})"

msgid "读取 Oracle 统一审计失败（{error}）"
msgstr "Failed to read Oracle unified audit ({error})"
