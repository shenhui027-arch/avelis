# 可选：Compose 编排参数。应用配置不在这里，在 avelis.toml。
# 需要修改时复制为同目录下的 .env：cp .env.example .env

# 发布端口与绑定地址：默认在本机浏览器访问 http://127.0.0.1:<AVELIS_HTTP_PORT>
AVELIS_HTTP_PORT=8080
# 默认只监听本机；从其他机器访问时设为 0.0.0.0 或具体网卡地址，并先修改默认管理员口令
# 生产环境建议保持本机监听，放在 HTTPS 反向代理之后
AVELIS_BIND_ADDRESS=127.0.0.1
# 镜像名：默认在本机构建；使用镜像仓库时改为仓库地址，如 registry.example.com/avelis:1.0.6
AVELIS_IMAGE=avelis:1.0.6
# 使用外部 PostgreSQL / Redis 时取消注释（Windows 上把冒号换成分号）
# COMPOSE_FILE=compose.yaml:compose.external.yaml
# 容器网络的子网；与本机或内网网段冲突时修改
AVELIS_DOCKER_SUBNET=10.240.18.0/24
