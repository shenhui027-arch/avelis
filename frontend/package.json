{
  "name": "avelis-frontend",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "check:i18n": "node scripts/check-i18n.mjs && node src/i18n/render.test.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "test": "node scripts/run-tests.mjs",
    "gen:api": "cd ../backend && uv run python -m avelis.bootstrap openapi ../frontend/src/api/openapi.json && cd ../frontend && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts --default-non-nullable false"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@tanstack/react-query": "5.104.2",
    "@xyflow/react": "12.12.0",
    "echarts": "6.1.0",
    "i18next": "26.5.12",
    "i18next-browser-languagedetector": "8.2.4",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
