# 演示环境配置。运行 `uv run scripts/demo.py init-env` 会复制本文件为 .env，
# 并为所有空的 *_PASSWORD 生成随机值。.env 不进仓库。
COMPOSE_PROJECT_NAME=avelis-demo
# 演示网络的固定子网；与本机网络冲突时修改
AVELIS_DEMO_SUBNET=10.240.17.0/24

# Avelis 元数据库：PostgreSQL 18 与 MySQL 8.4 两种都提供，用于兼容性开发与测试
AVELIS_PG_PORT=15432
AVELIS_PG_PASSWORD=
AVELIS_META_MYSQL_PORT=13307
AVELIS_META_MYSQL_PASSWORD=
META_MYSQL_ROOT_PASSWORD=

# Redis 协议（演示用 Valkey 8）：任务队列、缓存、采集锁
AVELIS_REDIS_PORT=16379
AVELIS_REDIS_PASSWORD=

# 演示 StarRocks 3.5.14（单容器）
SR_QUERY_PORT=19030
SR_HTTP_PORT=18030
SR_ROOT_PASSWORD=
SR_COLLECTOR_PASSWORD=
SR_READER_PASSWORD=
AVELIS_SR_FE_HEAP_MB=1024
AVELIS_SR_BE_MEM_MB=3072

# 演示电商维表库 MySQL 8.4（StarRocks 通过 JDBC Catalog 与 MySQL 外部表访问）
SHOP_MYSQL_PORT=13306
SHOP_MYSQL_ROOT_PASSWORD=
SHOP_MYSQL_COLLECTOR_PASSWORD=
SHOP_MYSQL_CATALOG_PASSWORD=
# 仅供 StarRocks 旧式 ENGINE=mysql 外部表使用（mysql_native_password）
SHOP_MYSQL_LEGACY_PASSWORD=

# Avelis 后端
# 元数据库后端：pg 或 mysql（两者都兼容；也可直接设置 AVELIS_DATABASE_URL）
AVELIS_META_BACKEND=pg
# 用于加密数据源口令与签发访问令牌；init-env 自动生成
AVELIS_SECRET=
AVELIS_BUSINESS_TIMEZONE=Asia/Shanghai
# 演示账号（admin、zhang、li、wang、zhao）的共同口令；init-env 自动生成
AVELIS_DEMO_USER_PASSWORD=
