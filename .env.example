# 本地开发与演示环境配置（.env 不进仓库）。
# 运行 `uv run scripts/demo.py init-env` 会复制本文件为 .env，保留已有值，并为空的 *_PASSWORD / *_SECRET 生成随机值（不打印）。
# 服务器部署请用配置文件 deploy/docker/avelis.example.toml，见 docs/deployment.md；全部配置项见 docs/configuration.md。
# 优先级：进程环境变量 > 本文件 > 配置文件（AVELIS_CONFIG）> 内置默认值。以 # 开头的 AVELIS_* 行是可选项，取消注释后生效。

# ============================================================
# 演示环境（scripts/demo.py、deploy/demo/compose.yaml）
# ============================================================
COMPOSE_PROJECT_NAME=avelis-demo
# 演示网络的固定子网；与本机网络冲突时修改
AVELIS_DEMO_SUBNET=10.240.17.0/24

# Avelis 元数据库：PostgreSQL 18（也存放 LangGraph 智能体的会话状态）
AVELIS_PG_PORT=15432
AVELIS_PG_PASSWORD=

# Redis 协议（演示用 Valkey 8）：任务队列、缓存、采集锁
AVELIS_REDIS_PORT=16379
AVELIS_REDIS_PASSWORD=

# 演示 StarRocks 3.5.14（单容器）
SR_QUERY_PORT=19030
SR_HTTP_PORT=18030
SR_ROOT_PASSWORD=
SR_COLLECTOR_PASSWORD=
SR_READER_PASSWORD=
AVELIS_SR_FE_HEAP_MB=1024
AVELIS_SR_BE_MEM_MB=3072

# 演示电商维表库 MySQL 8.4（StarRocks 通过 JDBC Catalog 与 MySQL 外部表访问）
SHOP_MYSQL_PORT=13306
SHOP_MYSQL_ROOT_PASSWORD=
SHOP_MYSQL_COLLECTOR_PASSWORD=
SHOP_MYSQL_CATALOG_PASSWORD=
# 仅供 StarRocks 旧式 ENGINE=mysql 外部表使用（mysql_native_password）
SHOP_MYSQL_LEGACY_PASSWORD=

# 演示线下门店库 PostgreSQL 18（第二种引擎）：postgres 只用于灌数，avelis_collector 读元数据，avelis_reader 只读查询
SHOP_PG_PORT=15433
SHOP_PG_PASSWORD=
SHOP_PG_COLLECTOR_PASSWORD=
SHOP_PG_READER_PASSWORD=
# 更多引擎的演示库（scripts/demo.py up --engines 时启动）
SHOP_CH_HTTP_PORT=18123
SHOP_CH_PASSWORD=
SHOP_CH_COLLECTOR_PASSWORD=
SHOP_CH_READER_PASSWORD=
SHOP_MSSQL_PORT=11433
SHOP_MSSQL_SA_PASSWORD=
SHOP_MSSQL_COLLECTOR_PASSWORD=
SHOP_MSSQL_READER_PASSWORD=
SHOP_ORACLE_PORT=11521
SHOP_ORACLE_SYSTEM_PASSWORD=
SHOP_ORACLE_COLLECTOR_PASSWORD=
SHOP_ORACLE_READER_PASSWORD=
SHOP_DORIS_QUERY_PORT=19130
SHOP_DORIS_HTTP_PORT=18130
SHOP_DORIS_ROOT_PASSWORD=
SHOP_DORIS_COLLECTOR_PASSWORD=
SHOP_DORIS_READER_PASSWORD=

# ============================================================
# Avelis 后端：必填
# ============================================================
# 【必填】元数据库连接串（只支持 PostgreSQL）；留空则使用上面的演示 PostgreSQL（127.0.0.1:AVELIS_PG_PORT）
AVELIS_DATABASE_URL=
# 也可以分项填写（AVELIS_DATABASE_URL 为空时生效）：
# AVELIS_DB_HOST=
# AVELIS_DB_PORT=5432
# AVELIS_DB_NAME=avelis
# AVELIS_DB_USER=avelis
# AVELIS_DB_PASSWORD=
# AVELIS_DB_SSLMODE=
# Redis 连接串；留空则使用上面的演示 Valkey（127.0.0.1:AVELIS_REDIS_PORT）
# AVELIS_REDIS_URL=
# 【必填】主密钥（至少 16 个字符）：加密数据源口令与模型密钥、签发访问令牌；init-env 自动生成
AVELIS_SECRET=

# ============================================================
# 服务（python -m avelis.server）
# ============================================================
# AVELIS_HOST=127.0.0.1
# AVELIS_PORT=8000
# AVELIS_WORKERS=1
# 构建好的前端目录（如 frontend/dist）；设置后同一端口托管前端。留空 = 只提供接口（开发时用 pnpm dev）
# AVELIS_FRONTEND_DIR=
# AVELIS_PUBLIC_URL=
# AVELIS_FORWARDED_ALLOW_IPS=127.0.0.1
# AVELIS_LOG_LEVEL=info
# 跨域白名单（逗号分隔）；默认允许 Vite 开发服务器
# AVELIS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 启动时自动迁移元数据库 / 创建首个管理员（部署用；开发时用 bootstrap migrate / admin）
# AVELIS_AUTO_MIGRATE=false
# AVELIS_AUTO_INIT_ADMIN=false
# AVELIS_INITIAL_ADMIN_USERNAME=admin
# AVELIS_DB_POOL_SIZE=5
# AVELIS_DB_MAX_OVERFLOW=10
# AVELIS_DB_POOL_RECYCLE_SECONDS=1800

# ============================================================
# 安全与登录
# ============================================================
# 单个登录凭证有效期（闲置超时），单位分钟；必须为正整数
AVELIS_ACCESS_TOKEN_MINUTES=120
# 一次登录最长可续期时长，单位小时；默认 168（7 天），到期后必须重新登录；必须为正整数
AVELIS_SESSION_MAX_HOURS=168
# 登录失败限流：同一账号 + 来源地址连续失败达到上限后锁定若干分钟
AVELIS_LOGIN_MAX_FAILURES=5
AVELIS_LOGIN_LOCK_MINUTES=15
# 是否允许提交人复核自己的变更
# AVELIS_ALLOW_SELF_REVIEW=false

# ============================================================
# 业务与治理
# ============================================================
AVELIS_BUSINESS_TIMEZONE=Asia/Shanghai
# 未归属业务域的资产：deny（默认，只有管理员与维护者可见）| allow
AVELIS_UNASSIGNED_ASSET_POLICY=deny
# 口径依赖的列缺数据库注释时：false（默认）只提示 | true 阻断发布
AVELIS_REQUIRE_COLUMN_COMMENTS=false

# ============================================================
# 问数与查询
# ============================================================
# 问数执行前核对来源结构是否与上次采集一致（不一致则拦截并排队采集）：true（默认）| false
AVELIS_ASK_LIVE_CHECK=true
# 单条查询超时（秒）、内存上限（字节）、返回行数上限；答案缓存时长（秒）
# AVELIS_QUERY_TIMEOUT_SECONDS=30
# AVELIS_QUERY_MEM_LIMIT_BYTES=2147483648
# AVELIS_QUERY_MAX_ROWS=1000
# AVELIS_ANSWER_CACHE_SECONDS=300
# 问数智能体一次回答中最多的工具调用轮数
# AVELIS_ASK_MAX_TOOL_ROUNDS=8

# ============================================================
# 采集、worker 与变更留底
# ============================================================
# 新建数据源的默认采集间隔（分钟）
# AVELIS_COLLECT_INTERVAL_MINUTES=15
# worker：轮询间隔、未入队任务的扫描阈值、运行超时（超时记为失败，不自动重跑），单位秒
AVELIS_WORKER_SCHEDULE_SECONDS=60
AVELIS_WORKER_STALE_SECONDS=30
AVELIS_WORKER_RUNNING_TIMEOUT_SECONDS=3600
# 变更留底（ADR 0008）：历史保留天数（默认 3 年，0 = 不清理）；worker 每隔多少小时清理一次超期历史
AVELIS_HISTORY_RETENTION_DAYS=1095
AVELIS_HISTORY_PURGE_INTERVAL_HOURS=24
# 变更记录一次导出的行数上限
AVELIS_HISTORY_EXPORT_MAX_ROWS=50000
# DDL 审计归因窗口两端的容差（秒），用于数据库与 Avelis 之间的时钟偏差；过大会把上个窗口的语句算进来
AVELIS_DDL_AUDIT_SLACK_SECONDS=5
# 导入血缘时单个文件或粘贴内容的上限（字节）
# AVELIS_IMPORT_MAX_BYTES=2097152

# ============================================================
# 分析智能体预算（每次分析；token 上限写 0 表示不限）
# ============================================================
# AVELIS_ANALYSIS_SECONDS=300
# AVELIS_ANALYSIS_TOOL_CALLS=30
# AVELIS_ANALYSIS_QUERY_LIMIT=20
# AVELIS_ANALYSIS_EXPLORE_LIMIT=8
# AVELIS_ANALYSIS_MODEL_REQUESTS=16
# AVELIS_ANALYSIS_INPUT_TOKENS=552321
# AVELIS_ANALYSIS_OUTPUT_TOKENS=30716
# AVELIS_MATERIAL_CHANGE_RATIO=0.01

# ============================================================
# 本地账号（只用于开发与演示）
# ============================================================
# 演示账号（自动化管理员 ops_admin、zhang、li、wang、zhao、sun）的共同密码；init-env 自动生成
AVELIS_DEMO_USER_PASSWORD=
# 本地超级管理员 admin（拥有全部角色）的密码；只用于本地开发，不经过密码策略校验。init-env 留空时自动生成
AVELIS_ADMIN_PASSWORD=

# ============================================================
# 模型（可替换）
# ============================================================
# 问数与导入血缘的模型。留空 = 演示模型（规则匹配，答案中会标明）。正式使用请在“设置 → 模型配置”页面维护；
# 这里的值只供 `uv run python -m avelis.bootstrap model` 登记
# AVELIS_MODEL_PROVIDER=anthropic | openai（openai 也用于任何 OpenAI 兼容接口）
AVELIS_MODEL_PROVIDER=
AVELIS_MODEL_NAME=
AVELIS_MODEL_BASE_URL=
AVELIS_MODEL_API_KEY=
# 是否允许把查询结果发给模型生成解释（默认否：只发元数据与用户自己的问题）
AVELIS_MODEL_SEND_RESULTS=false
# 分析智能体单次模型请求超时（秒）
# AVELIS_MODEL_TIMEOUT_SECONDS=60
